# Example environment file — copy to .env and fill in real values
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///shoplinq.db

# Set FLASK_DEBUG=1 for local development (enables the reloader and http cookies).
# Leave unset / 0 in production so secure cookies and logging are enforced.
FLASK_DEBUG=1

# DEMO_MODE=1 keeps simulated payments and surfaces the reset link in a flash.
# Set DEMO_MODE=0 in production.
DEMO_MODE=1

# Razorpay keys (https://dashboard.razorpay.com/app/keys)
# India payments: UPI, cards (RuPay/Visa/Mastercard), netbanking, wallets.
# If left empty, online payments are simulated in demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Email (SMTP) ---
# If MAIL_SERVER is empty, emails are logged instead of sent (demo mode).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_DEFAULT_SENDER=ShopLinq <no-reply@shoplinq.com>

# --- Production database examples ---
# PythonAnywhere MySQL:
#   DATABASE_URL=mysql://USER:PASSWORD@USER.mysql.pythonanywhere-services.com/USER$shoplinq
# PostgreSQL:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/shoplinq

# HTTPS-only session cookies in production. The app defaults this to 1 when
# FLASK_DEBUG is unset; set 0 only if you serve over plain HTTP.
#SESSION_COOKIE_SECURE=1
